#!/usr/bin/env bash
# Register and check Gmail reply monitors. Requires gws, jq, and alerter (optional).
set -euo pipefail
CONFIG_DIR="${NAGSLY_DIR:-$HOME/.config/nagsly}"
MONITORS_D="$CONFIG_DIR/monitors.d"
GWS="${GWS:-gws}"
GMAIL_WEB_BASE="${GMAIL_WEB_BASE:-https://mail.google.com/mail/u/0/#all/}"

json_quote() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}
field() { super -dynamic -f line -c "coalesce($2, \"\")" - <<<"$1"; }
build_query() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && { echo 'in:sent'; return; }
  if [[ "$arg" == *@* && "$arg" != *" "* ]]; then echo "in:sent to:$arg"
  elif [[ "$arg" == *:* || "$arg" == *" "* ]]; then echo "in:sent $arg"
  else echo "in:sent subject:$arg"; fi
}
gws_call() { "$GWS" "$@"; }

# Only accept links whose last component is an API-resolvable thread ID.
# Gmail also uses opaque browser-only IDs: the API check below rejects those
# rather than persisting a monitor that cannot be synced.
thread_id_from_url() {
  local url="$1"
  if [[ "$url" =~ ^https://mail\.google\.com/mail/u/[0-9]+/\#(all|sent|inbox)/([a-zA-Z0-9_-]+)$ ]]; then
    printf '%s' "${BASH_REMATCH[2]}"
  else
    echo 'nagsly monitor add gmail: expected a Gmail thread URL (https://mail.google.com/mail/u/N/#all/THREAD_ID or #sent/THREAD_ID)' >&2
    return 2
  fi
}

register() {
  local query_arg="${1:-}" query list ids msg id thread_id subject to chosen url stable_id file
  command -v "$GWS" >/dev/null 2>&1 || { echo "nagsly monitor add gmail: $GWS not found" >&2; return 127; }
  command -v jq >/dev/null 2>&1 || { echo 'nagsly monitor add gmail: jq not found' >&2; return 127; }
  command -v super >/dev/null 2>&1 || { echo 'nagsly monitor add gmail: super not found' >&2; return 127; }
  if [[ "$query_arg" == http://* || "$query_arg" == https://* ]]; then
    thread_id="$(thread_id_from_url "$query_arg")" || return $?
    local thread params
    params="$(printf '{"userId":"me","id":%s,"format":"metadata"}' "$(json_quote "$thread_id")")"
    thread="$(gws_call gmail users threads get --params "$params")" || {
      echo 'nagsly monitor add gmail: cannot resolve Gmail thread via gws (browser-only ID or missing Gmail access); try a recipient or search query' >&2; return 1;
    }
    # A link to a received-only thread must not silently register as a sent
    # reply monitor. Use the most recent SENT message for its title/recipient.
    msg="$(jq -ec --arg id "$thread_id" 'select(.id == $id and (.messages | type == "array")) | [.messages[] | select((.labelIds // []) | index("SENT") != null)] | last | select(. != null)' <<<"$thread")" || {
      echo 'nagsly monitor add gmail: thread has no sent message (or the URL is not an API thread ID)' >&2; return 1;
    }
    subject="$(jq -r '((.payload.headers // []) | map(select(.name=="Subject") | .value) | .[0]) // "(no subject)"' <<<"$msg")"
    to="$(jq -r '((.payload.headers // []) | map(select(.name=="To") | .value) | .[0]) // ""' <<<"$msg")"
    url="$query_arg"
  else
    query="$(build_query "$query_arg")"
    local params
    params="$(printf '{"userId":"me","q":%s,"maxResults":6}' "$(json_quote "$query")")"
    list="$(gws_call gmail users messages list --params "$params")" || {
      echo 'nagsly monitor add gmail: search failed (check gws Gmail read-only auth)' >&2; return 1;
    }
    ids="$(jq -r '.messages // [] | map(.id // empty) | join(" ")' <<<"$list")"
    [[ -n "$ids" ]] || { echo "nagsly monitor add gmail: no sent mail matches '$query'" >&2; return 1; }
    local -a idarr; IFS=' ' read -r -a idarr <<< "$ids"; chosen="${idarr[0]}"
    if (( ${#idarr[@]} > 1 )); then
      local i=0 pick
      for id in "${idarr[@]}"; do
        msg="$(gws_call gmail users messages get --params "{\"userId\":\"me\",\"id\":\"$id\",\"format\":\"metadata\"}")"
        i=$((i + 1))
        subject="$(jq -r '((.payload.headers // []) | map(select(.name=="Subject") | .value) | .[0]) // "(no subject)"' <<<"$msg")"
        to="$(jq -r '((.payload.headers // []) | map(select(.name=="To") | .value) | .[0]) // ""' <<<"$msg")"
        printf '  %d. %s  (to %s)\n' "$i" "$subject" "$to"
      done
      printf 'Choose message 1-%d [1]: ' "${#idarr[@]}"
      read -r pick || pick=1; pick="${pick:-1}"
      if [[ ! "$pick" =~ ^[0-9]+$ ]] || (( pick < 1 || pick > ${#idarr[@]} )); then
        echo "nagsly monitor add gmail: invalid selection '$pick'" >&2; return 2
      fi
      chosen="${idarr[$((pick - 1))]}"
    fi
    thread_id="$(jq -er --arg id "$chosen" '.messages[] | select(.id == $id) | .threadId | select(type == "string" and length > 0)' <<<"$list")" || {
      echo 'nagsly monitor add gmail: search returned no usable thread ID' >&2; return 1;
    }
    msg="$(gws_call gmail users messages get --params "{\"userId\":\"me\",\"id\":\"$chosen\",\"format\":\"metadata\"}")"
    subject="$(jq -r '((.payload.headers // []) | map(select(.name=="Subject") | .value) | .[0]) // "(no subject)"' <<<"$msg")"
    to="$(jq -r '((.payload.headers // []) | map(select(.name=="To") | .value) | .[0]) // ""' <<<"$msg")"
    url="$GMAIL_WEB_BASE$thread_id"
  fi
  stable_id="gmail-$(printf '%s' "$thread_id" | shasum -a 256 | cut -c1-12)"
  mkdir -p "$MONITORS_D"
  file="$MONITORS_D/$stable_id.json"
  if [[ -f "$file" ]]; then
    printf 'nagsly: Gmail thread already registered (%s); use nagsly monitor rm %s to reset\n' "$stable_id" "$stable_id"
    return 0
  fi
  printf '{"id":"%s","kind":"gmail","thread_id":%s,"title":%s,"to":%s,"url":%s,"status":"waiting","last_state":"waiting"}\n' \
    "$stable_id" "$(json_quote "$thread_id")" "$(json_quote "$subject")" "$(json_quote "$to")" "$(json_quote "$url")" > "$file.tmp.$$"
  mv -f "$file.tmp.$$" "$file"
  printf 'nagsly: registered Gmail thread "%s" (%s)\n' "$subject" "$stable_id"
}

derive_state() {
  jq -r 'if (.messages | length)==0 then "waiting" else (.messages[-1].labelIds // [] | if index("SENT")!=null or index("DRAFT")!=null then "waiting" else "replied" end) end' <<<"$1"
}
notify_reply() {
  local title="$1" url="$2" body="$3"
  if [[ -n "${NAGSLY_TEST_NOTIFY_LOG:-}" ]]; then printf '%s\n' "reply" >> "$NAGSLY_TEST_NOTIFY_LOG"; return 0; fi
  [[ -n "${NAGSLY_DRY_FIRE:-}" ]] && return 0
  if ! command -v alerter >/dev/null 2>&1; then
    echo 'nagsly-sync-gmail: alerter not found; cannot notify reply' >&2
    return 1
  fi
  local clicked
  if clicked="$(alerter --title "$title" --message "$body" --actions 'Open Thread' --timeout 30 2>&1)"; then
    if [[ -n "$clicked" && "$clicked" != '@TIMEOUT' && "$clicked" != '@CLOSED' ]] && command -v open >/dev/null 2>&1; then
      open "$url" >/dev/null 2>&1 || true
    fi
  else
    echo "nagsly-sync-gmail: alerter failed: $clicked" >&2
    return 1
  fi
  if [[ -f /System/Library/Sounds/Glass.aiff ]] && command -v afplay >/dev/null 2>&1; then
    # The toast is the notification; sound is best-effort. An audio-device
    # failure must not retry an already-delivered toast on every sync tick.
    afplay /System/Library/Sounds/Glass.aiff >/dev/null ||
      echo 'nagsly-sync-gmail: afplay failed (reply notification delivered)' >&2
  fi
}

sync_monitors() {
  command -v "$GWS" >/dev/null 2>&1 || { echo "nagsly-sync-gmail: $GWS not found" >&2; return 127; }
  command -v jq >/dev/null 2>&1 || { echo 'nagsly-sync-gmail: jq not found' >&2; return 127; }
  [[ -d "$MONITORS_D" ]] || return 0
  shopt -s nullglob
  local files=("$MONITORS_D"/gmail-*.json)
  shopt -u nullglob
  (( ${#files[@]} > 0 )) || return 0
  local file monitor id thread_id title url previous snapshot state updated who subject snippet thread_params failed=0 last_id current_id sent_since_last notify_needed state_json message_json
  for file in "${files[@]}"; do
    monitor="$(<"$file")"
    id="$(field "$monitor" id)"; thread_id="$(field "$monitor" thread_id)"
    title="$(field "$monitor" title)"; url="$(field "$monitor" url)"
    previous="$(field "$monitor" last_state)"
    last_id="$(field "$monitor" last_message_id)"
    thread_params="$(printf '{"userId":"me","id":%s,"format":"metadata"}' "$(json_quote "$thread_id")")"
    snapshot="$(gws_call gmail users threads get --params "$thread_params")" || {
      echo "nagsly-sync-gmail: failed to read thread $thread_id" >&2; failed=1; continue;
    }
    state="$(derive_state "$snapshot")"
    current_id="$(jq -r '.messages[-1].id // ""' <<<"$snapshot")" || { failed=1; continue; }
    notify_needed=0
    if [[ "$state" == replied ]]; then
      if [[ "$previous" != replied ]]; then
        notify_needed=1
      elif [[ -n "$last_id" && -n "$current_id" && "$last_id" != "$current_id" ]]; then
        # A complete send/reply cycle may happen between ticks. Only alert
        # again if we can see a new SENT message after the last observed one.
        sent_since_last="$(jq -r --arg id "$last_id" '
          (.messages | map(.id) | index($id)) as $pos
          | if $pos == null then false
            else any(.messages[($pos + 1):][]; (.labelIds // []) | index("SENT") != null)
            end' <<<"$snapshot")" || { failed=1; continue; }
        [[ "$sent_since_last" != true ]] || notify_needed=1
      fi
    fi
    if (( notify_needed )); then
      who="$(jq -r '(.messages[-1].payload.headers // [] | map(select(.name=="From") | .value) | .[0]) // "someone"' <<<"$snapshot")"
      subject="$(jq -r '(.messages[-1].payload.headers // [] | map(select(.name=="Subject") | .value) | .[0]) // ""' <<<"$snapshot")"
      snippet="$(jq -r '.messages[-1].snippet // ""' <<<"$snapshot")"
      if ! notify_reply "$title" "$url" "Reply from $who${subject:+ — $subject}${snippet:+: $snippet}"; then
        failed=1; continue
      fi
      printf 'nagsly: reply received from %s — %s\n' "$who" "$url"
    fi
    updated="$MONITORS_D/.$(basename "$file").tmp.$$"
    state_json="$(json_quote "$state")"
    message_json="$(json_quote "$current_id")"
    super -dynamic -f json -c "put last_state := $state_json | put status := $state_json | put last_message_id := $message_json" "$file" > "$updated"
    mv -f "$updated" "$file"
  done
  return "$failed"
}

usage() {
  cat <<'EOF'
Usage: nagsly monitor add gmail [recipient|Gmail query|Gmail thread URL]

A URL must be a mail.google.com/mail/u/N/#all/ID, #sent/ID, or #inbox/ID
link whose ID resolves through the Gmail API. Some Gmail browser links use
browser-only IDs; if the URL cannot be resolved, use a recipient or query.
EOF
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-}" in
    --register)
      shift
      case "${1:-}" in
        -h|--help|help) usage ;;
        *) register "${1:-}" ;;
      esac
      ;;
    --sync) sync_monitors ;;
    -h|--help|help) usage ;;
    *) register "${1:-}" ;;
  esac
fi
